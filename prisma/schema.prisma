// Schema mirrors the shape of the files in /data, so `node prisma/seed.js`
// loads the site as it stands today and lib/content.js can switch over without
// any page changing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  tagline     String
  summary     String
  description Json // array of paragraphs
  occupancy   String
  gallery     Json // array of photo paths, [] if none yet
  amenities   Json
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Package {
  id                String   @id @default(uuid())
  slug              String   @unique
  name              String
  summary           String
  pricePerPerson    Int
  duration          String?
  places            Json?
  stay              String
  meals             String
  inclusions        Json
  exclusions        Json
  image             String
  imageAlt          String
  needsConfirmation Json
  order             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Vehicle {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  seats       String
  seatCount   Int
  bestFor     String
  description String
  image       String?
  imageAlt    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Destination {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  where     String
  note      String
  image     String
  alt       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  phone     String
  need      String
  people    Int?
  arrival   String?
  message   String?
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
