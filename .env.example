# Public site URL, used for metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL="https://www.nimmagaddavariandhratoursandtravels.com"

# Leave DATABASE_URL empty and the whole site renders from the files in /data.
# Set it, then run `npm run db:push && npm run db:seed`, and lib/content.js
# reads from Postgres instead. No page code changes.
DATABASE_URL=""
